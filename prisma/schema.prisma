generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id          String    @id @default(cuid())
  firebaseUid String?   @unique
  name        String
  email       String    @unique
  phone       String?
  photoUrl    String?
  role        Role      @default(BUYER)
  orders      Order[]
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String
  category    String
  price       Int
  mrp         Int
  stock       Int
  imageUrl    String?
  imageFileId String?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  @@index([category])
  @@index([price])
}

model Order {
  id            String        @id @default(cuid())
  ref           String        @unique
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  name          String
  phone         String
  address       Json
  total         Int
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  upiTxnId      String?       @unique
  status        OrderStatus   @default(PLACED)
  items         OrderItem[]
  createdAt     DateTime      @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  title     String
  qty       Int
  price     Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}