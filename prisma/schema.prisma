generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id          String    @id @default(cuid())
  firebaseUid String?   @unique
  name        String
  email       String    @unique
  phone       String?
  photoUrl    String?
  role        Role      @default(BUYER)
  orders      Order[]
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String
  category    String
  price       Int
  mrp         Int
  stock       Int
  imageUrl    String?
  imageFileId String?
  // Packed size of ONE piece. Used to price delivery. Defaults match the old fixed values.
  weightG     Int         @default(200)
  lengthCm    Int         @default(25)
  widthCm     Int         @default(20)
  heightCm    Int         @default(5)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]

  @@index([category])
  @@index([price])
}

model Order {
  id            String        @id @default(cuid())
  ref           String        @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PLACED)
  upiTxnId      String?       @unique
  subtotal      Int           @default(0)
  shipping      Int           @default(0)
  codCharge     Int           @default(0)
  total         Int
  name          String
  phone         String
  address       String        @default("")
  city          String        @default("")
  state         String        @default("")
  pincode       String        @default("")
  items         OrderItem[]
  createdAt     DateTime      @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  title     String
  price     Int
  qty       Int
  product   Product @relation(fields: [productId], references: [id])
}

