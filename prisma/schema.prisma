generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  BUYER
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id              String           @id @default(cuid())
  firebaseUid     String?          @unique
  name            String
  email           String           @unique
  phone           String?
  photoUrl        String?
  role            Role             @default(BUYER)
  orders          Order[]
  promoUsages     PromoCodeUsage[]
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
}

model Product {
  id              String      @id @default(cuid())
  title           String
  description     String
  category        String
  price           Int
  mrp             Int
  stock           Int
  imageUrl        String?
  imageFileId     String?
  images          String[]    @default([])
  imageFileIds    String[]    @default([])
  sizes           String[]    @default([])
  colors          String[]    @default([])
  // Packed size of ONE piece. Used to price delivery. Defaults to light garment flyer (200g, 25x20x3 cm).
  weightG         Int         @default(200)
  lengthCm        Int         @default(25)
  widthCm         Int         @default(20)
  heightCm        Int         @default(3)
  createdAt       DateTime    @default(now())
  basePrice       Int @default(0)  // buffer ke bina original price
  shippingBuffer  Int @default(0)
  orderItems      OrderItem[]
  reviews         Review[]

  @@index([category])
  @@index([price])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  userName  String
  userEmail String?
  rating    Int      @default(5)
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Order {
  id              String          @id @default(cuid())
  ref             String          @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus   @default(PENDING)
  status          OrderStatus     @default(PLACED)
  upiTxnId        String?         // Legacy UTR field
  cashfreeOrderId String?         // Cashfree's cf_order_id
  subtotal        Int             @default(0)
  discount        Int             @default(0)
  promoCode       String?         // promo code used (if any)
  shipping        Int             @default(0)
  codCharge       Int             @default(0)
  total           Int
  name            String
  phone           String
  address         String          @default("")
  city            String          @default("")
  state           String          @default("")
  pincode         String          @default("")
  nimbusOrderId   String?
  awb             String?
  courierName     String?
  trackingUrl     String?
  labelUrl        String?
  items           OrderItem[]
  promoUsage      PromoCodeUsage?
  createdAt       DateTime        @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  title     String
  price     Int
  qty       Int
  size      String?
  color     String?
  product   Product @relation(fields: [productId], references: [id])
}

model PromoCode {
  id             String           @id @default(cuid())
  code           String           @unique
  discountPct    Int              // e.g. 20 for 20%
  maxUsesPerUser Int              @default(1)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  usages         PromoCodeUsage[]
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String?   @unique
  order       Order?    @relation(fields: [orderId], references: [id])
  usedAt      DateTime  @default(now())

  @@unique([promoCodeId, userId])
  @@index([userId])
}
